; aleph-manifest.lsp - privacy-safe native DWG manifest exporter (Epic #413 SS11.8).
; Dumps ONLY aggregate facts (counts, declared units, xref flags, extents) to a text file.
; Never writes entity coordinates, names, or text content -- safe to run on a customer
; drawing without leaking design data. Load, then call:
;   (aleph:dump "C:/path/out.txt")
; INSUNITS legend (getvar): 0=unitless 1=inches 2=feet 4=mm 5=meters.
(defun aleph:dump ( outpath / f tb nm fl nl nx nanon total sel sel2 sel3 )
  (setq f (open outpath "w"))
  (if (null f) (progn (princ "\n[aleph-manifest] cannot open output file") (exit)))
  (write-line "=== ALEPH LIVE DRAWING MANIFEST (native) ===" f)
  (write-line (strcat "DOC=" (getvar "DWGNAME")) f)
  (write-line (strcat "FULLPATH=" (getvar "DWGPREFIX")) f)
  (write-line (strcat "INSUNITS=" (itoa (getvar "INSUNITS"))) f)
  (write-line (strcat "LUNITS=" (itoa (getvar "LUNITS"))) f)
  (write-line (strcat "LUPREC=" (itoa (getvar "LUPREC"))) f)
  (write-line (strcat "TILEMODE=" (itoa (getvar "TILEMODE"))) f)
  (write-line (strcat "CTAB=" (getvar "CTAB")) f)
  (write-line (strcat "EXTMIN=" (rtos (car (getvar "EXTMIN")) 2 2) "," (rtos (cadr (getvar "EXTMIN")) 2 2)) f)
  (write-line (strcat "EXTMAX=" (rtos (car (getvar "EXTMAX")) 2 2) "," (rtos (cadr (getvar "EXTMAX")) 2 2)) f)
  (setq nl 0)
  (setq tb (tblnext "LAYER" T))
  (while tb (setq nl (1+ nl)) (setq tb (tblnext "LAYER")))
  (setq total 0 nx 0 nanon 0)
  (setq tb (tblnext "BLOCK" T))
  (while tb
    (setq total (1+ total))
    (setq nm (cdr (assoc 2 tb)))
    (setq fl (cdr (assoc 70 tb)))
    (if (/= 0 (logand fl 4)) (setq nx (1+ nx)))
    (if (= (substr nm 1 1) "*") (setq nanon (1+ nanon)))
    (setq tb (tblnext "BLOCK"))
  )
  (write-line (strcat "LAYER_COUNT=" (itoa nl)) f)
  (write-line (strcat "BLOCK_TABLE_TOTAL=" (itoa total)) f)
  (write-line (strcat "BLOCK_XREF_COUNT=" (itoa nx)) f)
  (write-line (strcat "BLOCK_ANON_COUNT=" (itoa nanon)) f)
  (write-line (strcat "BLOCK_NAMED_NONXREF=" (itoa (- total nx nanon))) f)
  (setq sel (ssget "_X" (list (cons 410 "Model"))))
  (write-line (strcat "MODEL_SPACE_ENTITY_COUNT=" (itoa (if sel (sslength sel) -1))) f)
  (setq sel2 (ssget "_X" (list (cons 0 "INSERT"))))
  (write-line (strcat "INSERT_COUNT=" (itoa (if sel2 (sslength sel2) 0))) f)
  (setq sel3 (ssget "_X" (list (cons 0 "TEXT,MTEXT"))))
  (write-line (strcat "TEXT_ENTITY_COUNT=" (itoa (if sel3 (sslength sel3) 0))) f)
  (close f)
  (princ (strcat "\n[aleph-manifest] wrote " outpath))
  (princ)
)