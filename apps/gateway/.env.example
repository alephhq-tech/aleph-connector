GATEWAY_PORT=8090
ALEPH_GATEWAY_URL=http://127.0.0.1:8090
# MCP resource URL that access tokens are minted for (audience).
MCP_RESOURCE_URL=http://127.0.0.1:8080/mcp

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/aleph_connector_dev
# bun run db:migrate

JWT_SECRET=replace-with-at-least-16-chars
# Shared with Connector for POST /oauth/connector/approve
CONNECTOR_APPROVE_SECRET=replace-with-shared-connector-approve-secret
# Optional legacy alias:
# PORTAL_APPROVE_SECRET=...

# Deep link opened by /oauth/login (Windows Connector protocol handler).
CONNECTOR_CONSENT_URI=aleph-connector://oauth/consent
CONNECTOR_APP_CALLBACK_URI=aleph-connector://auth/callback

# Google sign-in (copy GOOGLE_CLIENT_* from aleph-cloud/.env). Register redirect URIs:
#   http://127.0.0.1:8090/auth/google/callback
#   https://gateway.alephhq.tech/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8090/auth/google/callback

# ALEPH_DEV_IDENTITY=1

NODE_ENV=development
LOG_LEVEL=info
