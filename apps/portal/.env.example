PORTAL_PORT=3000
PORTAL_URL=http://127.0.0.1:3000

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/aleph_connector_dev
REDIS_URL=redis://HOST:6379
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_secret
REDIS_KEY_PREFIX=aleph:

# Must match mcp-server JWT_SECRET (ABT device credentials).
JWT_SECRET=replace-with-at-least-16-chars
# Optional; defaults to JWT_SECRET. Used only if you want a separate cookie pepper later.
# PORTAL_SESSION_SECRET=replace-with-session-secret

# Shared with mcp-server PORTAL_APPROVE_SECRET (Bearer for POST /oauth/portal/approve).
PORTAL_APPROVE_SECRET=replace-with-shared-portal-approve-secret

# MCP OAuth AS origin (no trailing slash). Local default matches mcp-server ALEPH_PUBLIC_URL.
MCP_PUBLIC_URL=http://127.0.0.1:8080

NODE_ENV=development
LOG_LEVEL=info
