# Copy this file to `.env` (same folder) and fill in real values. `.env` is gitignored — never commit
# real tokens. Bun loads `.env` relative to the CURRENT WORKING DIRECTORY, so this applies when the
# portal runs from this folder. Nothing in ARCDIO loads env from the repository root.
#
# PLANNED: apps/portal is a contract-only placeholder today (README, no code/package.json yet), so
# nothing reads these at runtime. They record the ownership boundary the portal will hold: account
# onboarding, OAuth consent, device pairing and grants, downloads, device/version status.

# --- HTTP listener ---
PORTAL_PORT=3000

# --- Accounts, pairing, and grants (ARCDIO's own database, never another product's) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/arcdio_dev
# Sessions, pairing-challenge state, and rate limits; a shared instance requires an ARCDIO prefix.
REDIS_URL=redis://HOST:6379
REDIS_KEY_PREFIX=arcdio:

# --- Identity ---
# Signs ARCDIO-issued MCP client and device credentials. Must match the value apps/mcp-server uses,
# because the MCP server verifies what the portal issues. NEVER reuse a development secret in
# production.
JWT_SECRET=change-me

# The URL the portal tells connectors and MCP clients to dial (Remote Mode).
MCP_PUBLIC_URL=https://mcp.example.com/mcp

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
