# Copy this file to `.env` (same folder) and fill in real values. `.env` is gitignored — never commit
# real tokens. Bun loads `.env` automatically on `bun run`/`bun start` relative to the CURRENT WORKING
# DIRECTORY, so this file applies when you run the MCP server from this folder:
#   cd apps/mcp-server && bun run dev
# Nothing in ARCDIO loads env from the repository root.

# --- HTTP listener ---
# Port the combined HTTP (MCP) + WSS (device) listener binds to.
MCP_AUTOCAD_PORT=8080
# Path the Streamable HTTP MCP endpoint is served on.
MCP_PATH=/mcp

# --- Data & cache (shared ARCDIO infra; this app's own data, never another product's database) ---
# Today the server runs on the in-memory parity tier: the PostgreSQL adapter is not wired yet, so
# these values are read by nothing at runtime and the durable tier is a planned step. They live here
# (not at the repository root) because this app owns them when that adapter lands.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/arcdio_dev
# A shared Redis instance is allowed only with an ARCDIO-specific key prefix.
REDIS_URL=redis://HOST:6379
REDIS_KEY_PREFIX=arcdio:

# --- MCP client & device authentication ---
# No static token allowlists. Both /mcp and /device verify signed ARCDIO credentials using
# JWT_SECRET (must match the ARCDIO issuer's value). NEVER reuse a development JWT_SECRET in
# production.

# --- Device Gateway (embedded — the Windows Connector connects here over WSS) ---
# Path the connector's WebSocket connects to.
DEVICE_GATEWAY_PATH=/device
# Milliseconds to wait for a device's hello frame after the WebSocket opens before dropping it.
DEVICE_GATEWAY_HELLO_TIMEOUT_MS=10000
# Milliseconds to wait for a capability result before a tool call times out.
DEVICE_GATEWAY_EXECUTE_TIMEOUT_MS=15000
# Milliseconds between server-side heartbeat sweeps over connected devices.
DEVICE_GATEWAY_HEARTBEAT_INTERVAL_MS=30000
# Milliseconds of heartbeat silence before a device is considered dead and disconnected.
DEVICE_GATEWAY_HEARTBEAT_TIMEOUT_MS=90000

# --- Runtime ---
# One of: development | production.
NODE_ENV=development
# One of: debug | info | warn | error. Anything else falls back to info.
LOG_LEVEL=info
