MCP_AUTOCAD_PORT=8080
MCP_PATH=/mcp

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/aleph_connector_dev
REDIS_URL=redis://HOST:6379
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_secret
REDIS_KEY_PREFIX=aleph:

# Must match apps/gateway JWT_SECRET (MCP access tokens + device ABT).
JWT_SECRET=replace-with-at-least-16-chars

# Public MCP origin (resource = ALEPH_PUBLIC_URL + MCP_PATH).
ALEPH_PUBLIC_URL=http://127.0.0.1:8080
# OAuth AS issuer — Aleph Gateway.
ALEPH_GATEWAY_URL=http://127.0.0.1:8090

# ALEPH_DEV_IDENTITY=1

DEVICE_GATEWAY_PATH=/device
DEVICE_GATEWAY_HELLO_TIMEOUT_MS=10000
DEVICE_GATEWAY_EXECUTE_TIMEOUT_MS=15000
DEVICE_GATEWAY_HEARTBEAT_INTERVAL_MS=30000
DEVICE_GATEWAY_HEARTBEAT_TIMEOUT_MS=90000

NODE_ENV=development
LOG_LEVEL=info
