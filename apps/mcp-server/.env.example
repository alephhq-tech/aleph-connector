MCP_AUTOCAD_PORT=8080
MCP_PATH=/mcp

# Local runtime state (secret, grants, CAD State db). Defaults to %LOCALAPPDATA%/CadAI/connector.
# ALEPH_LOCAL_STATE_DIR=
# Bridge identity.json the runtime writes. Defaults to %LOCALAPPDATA%/CadAI/bridge/identity.json.
# ALEPH_LOCAL_IDENTITY_PATH=

DEVICE_GATEWAY_PATH=/device
DEVICE_GATEWAY_HELLO_TIMEOUT_MS=10000
DEVICE_GATEWAY_EXECUTE_TIMEOUT_MS=15000
DEVICE_GATEWAY_HEARTBEAT_INTERVAL_MS=30000
DEVICE_GATEWAY_HEARTBEAT_TIMEOUT_MS=90000

NODE_ENV=development
LOG_LEVEL=info
