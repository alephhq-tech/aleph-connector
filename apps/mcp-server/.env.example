# Copy this file to `.env` (same folder) and fill in real values. `.env` is gitignored — never commit real tokens.
# Bun loads `.env` automatically on `bun run`/`bun start`, relative to the CURRENT WORKING DIRECTORY the
# command runs from, not this file's location — so this `.env` only applies when you `cd` into this
# directory and run `bun run dev` from here. If you instead run `bun run dev:mcp-autocad` from the
# aleph-cloud repo root (the documented way to run it as a separate process — see aleph-cloud/AGENTS.md
# §1), these same variable names belong in `aleph-cloud/.env` instead, alongside `PORT` (the Gateway's,
# a different value — see below) — put them there, not here, for that workflow.

# --- HTTP listener ---
# Port the combined HTTP (MCP) + WSS (device) listener binds to. Named distinctly from `PORT` (the
# Gateway's own listener) since both apps are commonly run from the same aleph-cloud `.env` — reusing
# `PORT` here would make the two processes fight over the same port.
MCP_AUTOCAD_PORT=8080

# --- MCP client & Bridge authentication ---
# No static token allowlists. Both /mcp and /device verify signed Aleph Bridge
# credentials using JWT_SECRET (must match Aleph Cloud Gateway's value).
# Normal local dev: sign in to Aleph Desktop and install AutoCAD integration.
# Standalone local Bridge/MCP tests: use 'bun run dev:autocad:credential' from
# the aleph-cloud root to mint a short-lived, randomly identified test credential.
# NEVER use that development helper or development JWT_SECRET in production.

# --- Device Gateway (embedded — Bridge connects here over WSS) ---
# Path the Bridge's WebSocket connects to.
DEVICE_GATEWAY_PATH=/device
# Milliseconds to wait for a device's hello frame after the WebSocket opens before dropping the connection.
DEVICE_GATEWAY_HELLO_TIMEOUT_MS=10000
# Default milliseconds to wait for a capability.result before a tool call fails with a timeout.
DEVICE_GATEWAY_EXECUTE_TIMEOUT_MS=15000
# Milliseconds between server-side heartbeat sweeps over connected devices.
DEVICE_GATEWAY_HEARTBEAT_INTERVAL_MS=30000
# Milliseconds of heartbeat silence before a device is considered dead and disconnected.
DEVICE_GATEWAY_HEARTBEAT_TIMEOUT_MS=90000

# --- Logging (shared by every app importing @arcdio/observability) ---
# One of: debug | info | warn | error. Anything else falls back to info.
LOG_LEVEL=info
