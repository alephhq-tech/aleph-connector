{
  "name": "@aleph-connector/root",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run typecheck",
    "typecheck": "tsc -b --pretty false",
    "test": "bun test",
    "build:runtime": "bun run apps/mcp-server/scripts/build-runtime.ts",
    "build:stdio": "bun build --compile apps/mcp-server/src/stdio-proxy.ts --outfile windows/connector-app/src-tauri/binaries/aleph-mcp-stdio.exe"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
