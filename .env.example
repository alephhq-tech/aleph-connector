NODE_ENV=development
MCP_AUTOCAD_PORT=8080

# ARCDIO uses the same PostgreSQL instance as Aleph but never the same database.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/arcdio_dev

# A shared Redis instance is allowed only with an ARCDIO-specific key prefix.
REDIS_URL=redis://HOST:6379
REDIS_KEY_PREFIX=arcdio:
